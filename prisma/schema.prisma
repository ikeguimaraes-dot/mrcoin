generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CANCELED
}

enum OrganizationPlan {
  TRIAL
  STANDARD
  ENTERPRISE
}

enum AdminRole {
  OWNER
  MANAGER
  OPERATOR
  VIEWER
}

enum AdminUserStatus {
  ACTIVE
  INACTIVE
}

enum MembershipType {
  CUSTOMER
  EMPLOYEE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum BatchStatus {
  PENDING
  PAID
  REJECTED
  EXPIRED
  CANCELED
}

enum LedgerEntryType {
  CREDIT
  DEBIT
  REVERSAL
  EXPIRE
}

enum LedgerReferenceType {
  DISTRIBUTION
  REDEMPTION
  EXPIRATION
  CAMPAIGN
  MANUAL_ADJUSTMENT
  REVERSAL
  TRANSFER
}

enum DistributionStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
}

enum DistributionItemStatus {
  PENDING
  OK
  FAILED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  FINISHED
}

enum PartnerStatus {
  ACTIVE
  INACTIVE
}

enum OfferStatus {
  ACTIVE
  INACTIVE
}

/// PENDING/EXPIRED nunca mais são escritos pela aplicação (resgate virou compra instantânea
/// — ver RedemptionsService) — ficam no tipo só porque o Postgres não permite DROP VALUE de
/// enum sem recriar o tipo inteiro, e não vale o risco pra remediar a única linha órfã que
/// existe em produção (nunca debitou nada). CONFIRMED nasce já com o débito feito;
/// DELIVERED é só a marcação de entrega física, sem efeito financeiro.
enum RedemptionStatus {
  PENDING
  CONFIRMED
  EXPIRED
  DELIVERED
}

enum DeliveredByType {
  PARTNER
  PLATFORM_ADMIN
}

enum SettlementStatus {
  OPEN
  CLOSED
  PAID
}

enum JobName {
  RECONCILE_BALANCES
  VERIFY_HASH_CHAIN
}

enum JobRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum AuditActorType {
  ADMIN
  SYSTEM
}

/// ACTIVE: já provou posse de um contato (fez signup por OTP). PENDING_CLAIM: conta
/// pré-criada por uma distribuição, sem nenhum contato verificado — só vira ACTIVE
/// quando a própria pessoa reivindicar via OTP (ver signup.service.ts).
enum UserStatus {
  ACTIVE
  PENDING_CLAIM
}

// ─────────────────────────────────────────────────────────────────────────
// Modelos
// ─────────────────────────────────────────────────────────────────────────

/// Empresa cliente da plataforma. Compra lotes de coins e distribui para
/// clientes ou funcionários. Fronteira do isolamento multi-tenant.
model Organization {
  id              String             @id @default(cuid())
  name            String
  cnpj            String             @unique
  status          OrganizationStatus @default(ACTIVE)
  plan            OrganizationPlan   @default(TRIAL)
  asaasCustomerId String?            @unique
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  adminUsers      AdminUser[]
  memberships     Membership[]
  coinBatches     CoinBatch[]
  distributions   Distribution[]
  campaigns       Campaign[]
  auditLogs       AuditLog[]
  adminInvites    AdminInvite[]
  conversionRates ConversionRate[]
}

/// Usuário do painel administrativo (coins-admin) de uma organização.
/// Hierarquia de papéis: OWNER > MANAGER > OPERATOR > VIEWER.
model AdminUser {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  email          String          @unique
  passwordHash   String
  role           AdminRole
  mfaEnabled     Boolean         @default(false)
  mfaSecret      String?
  status         AdminUserStatus @default(ACTIVE)
  lastLoginAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  distributions Distribution[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  sentInvites   AdminInvite[]

  @@index([organizationId])
}

enum PlatformAdminStatus {
  ACTIVE
  INACTIVE
}

/// Dono da plataforma (mrcoin) — nível de acesso acima de AdminUser e Partner, sem
/// organizationId (platform-wide, como Partner). MFA é obrigatório sem exceção (ver
/// PlatformAdminAuthService), diferente de AdminUser onde só OWNER/MANAGER são forçados.
model PlatformAdmin {
  id           String              @id @default(cuid())
  name         String
  email        String              @unique
  passwordHash String
  mfaEnabled   Boolean             @default(false)
  mfaSecret    String?
  status       PlatformAdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  refreshTokens PlatformAdminRefreshToken[]
  auditLogs     PlatformAdminAuditLog[]
}

/// Mesma mecânica de RefreshToken/PartnerRefreshToken: rotação por family, hash sha256,
/// detecção de reuso derruba a family inteira.
model PlatformAdminRefreshToken {
  id              String        @id @default(cuid())
  platformAdminId String
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id])
  tokenHash       String        @unique
  family          String
  replacedById    String?       @unique
  revokedAt       DateTime?
  expiresAt       DateTime
  createdAt       DateTime      @default(now())
  ip              String?
  userAgent       String?

  @@index([platformAdminId])
  @@index([family])
}

/// Trilha de auditoria própria do PlatformAdmin — a tabela AuditLog exige organizationId
/// (NOT NULL) e o enum AuditActorType só tem ADMIN/SYSTEM, então não serve para um ator
/// platform-wide (mesmo motivo pelo qual Partner não grava em AuditLog).
/// platformAdminId nulo registra tentativa de login com e-mail desconhecido, sem FK.
model PlatformAdminAuditLog {
  id              String         @id @default(cuid())
  platformAdminId String?
  platformAdmin   PlatformAdmin? @relation(fields: [platformAdminId], references: [id])
  action          String
  payload         Json
  ip              String
  createdAt       DateTime       @default(now())

  @@index([platformAdminId, createdAt])
}

/// Usuário final (cliente ou funcionário), identificado por CPF. Não
/// pertence diretamente a uma organização — o vínculo é via Membership,
/// já que a mesma pessoa pode participar de várias empresas.
model User {
  id                   String     @id @default(cuid())
  cpfEncrypted         String
  cpfHash              String     @unique
  name                 String
  phone                String?
  email                String?
  status               UserStatus @default(ACTIVE)
  notificationsEnabled Boolean    @default(true)
  /// Hash argon2id (hashPassword/verifyPassword, mesma função de senha) do PIN de 4-6
  /// dígitos exigido em POST /redemptions. Nulo = usuário ainda não configurou (ver
  /// hasTransactionPin em GET /users/me).
  transactionPinHash   String?
  /// Hash argon2id (hashPassword/verifyPassword, mesma função de senha/PIN) da senha de
  /// login do app. Nulo = conta ainda sem senha — todo User anterior a esta feature nasce
  /// assim; todo signup novo já sai com isso preenchido (SignupService.verifyOtp). Só
  /// reescrito por POST /users/password/recovery/confirm, sempre incondicional (sem branch
  /// de "primeira vez" — CPF sem senha e senha errada precisam ser indistinguíveis no login).
  passwordHash         String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  memberships   Membership[]
  devices       Device[]
  refreshTokens UserRefreshToken[]
}

/// Refresh token de sessão do usuário final (coins-app) — mesmo mecanismo do RefreshToken
/// de AdminUser (rotação por family, hash sha256 em repouso, detecção de reuso), só que pro
/// model User. Implementação paralela de propósito: RefreshToken/TokenService do admin
/// dependem de organizationId/role e gravam AuditLog, conceitos que um User não tem.
model UserRefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  tokenHash    String    @unique
  family       String
  replacedById String?   @unique
  revokedAt    DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  ip           String?
  userAgent    String?

  @@index([userId])
  @@index([family])
}

/// Registro do celular de um User pra push notification — upsert por (userId, fingerprint),
/// nunca duplica linha quando o mesmo aparelho reenvia (ex.: refresh de push token).
model Device {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  fingerprint String
  pushToken   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, fingerprint])
}

/// Vínculo entre um User e uma Organization. Cada Membership tem sua
/// própria Wallet — coins de organizações diferentes nunca se misturam.
model Membership {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  type           MembershipType
  externalRef    String?
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  wallet            Wallet?
  distributionItems DistributionItem[]
  redemptions       Redemption[]
  sentTransfers     Transfer[]         @relation("TransferSender")
  receivedTransfers Transfer[]         @relation("TransferRecipient")

  @@unique([userId, organizationId])
  @@index([organizationId])
}

/// Pedido de signup pendente — código OTP de 6 dígitos (hash), aguardando verificação.
/// Signup só existe como claim de um User PENDING_CLAIM já existente (prova só o CPF, sem
/// escolher organização — a(s) Membership(s) já existe(m), criada(s) pela distribuição). Se
/// o CPF não tiver User PENDING_CLAIM, o request é rejeitado antes de chegar aqui
/// (CpfNotInvitedException) — nunca cria User "parcial".
model UserSignupRequest {
  id           String    @id @default(cuid())
  cpfEncrypted String
  cpfHash      String
  name         String
  phone        String?
  email        String
  codeHash     String
  attempts     Int       @default(0)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([cpfHash])
}

/// Pedido de OTP pra RECUPERAÇÃO DE SENHA (usuário que já existe) — login por CPF+senha é
/// síncrono, sem OTP no caminho feliz; isto só serve pra provar posse do CPF antes de
/// (re)definir passwordHash. Mais enxuto que UserSignupRequest de propósito: não cria nem
/// vincula nada, então não tem organizationId nem campos de join-em-org (membershipType,
/// externalRef, name/phone/email do formulário). O OTP sempre vai pro e-mail já cadastrado
/// no User (PasswordRecoveryService), nunca aceita destino do request. Renomeado de
/// UserLoginRequest — mesma forma, história de uso diferente (RENAME TABLE, sem perda de
/// dado/índice).
model UserPasswordResetRequest {
  id         String    @id @default(cuid())
  cpfHash    String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([cpfHash])
}

/// Carteira de coins de um Membership. `cachedBalance` e `version` só
/// podem ser alterados pelo LedgerService, dentro de uma transação.
model Wallet {
  id            String     @id @default(cuid())
  membershipId  String     @unique
  membership    Membership @relation(fields: [membershipId], references: [id])
  cachedBalance Int        @default(0)
  version       Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  ledgerEntries LedgerEntry[]
  redemptions   Redemption[]
}

/// Movimentação imutável de coins. Nunca é atualizada nem apagada —
/// correções são um novo entry do tipo REVERSAL. Cadeia de hash
/// (`prevHash` → `hash`) garante integridade sequencial por carteira.
/// `batch`/`distributionItem` são onDelete: Restrict de propósito — `batchId`
/// entra no payload do hash; um SET NULL em cascata mudaria esse campo por
/// baixo do código e quebraria o hash sem nenhum UPDATE explícito.
model LedgerEntry {
  id                 String              @id @default(cuid())
  walletId           String
  wallet             Wallet              @relation(fields: [walletId], references: [id])
  type               LedgerEntryType
  amount             Int
  balanceAfter       Int
  idempotencyKey     String              @unique
  referenceType      LedgerReferenceType
  referenceId        String
  batchId            String?
  batch              CoinBatch?          @relation(fields: [batchId], references: [id], onDelete: Restrict)
  distributionItemId String?
  distributionItem   DistributionItem?   @relation(fields: [distributionItemId], references: [id], onDelete: Restrict)
  description        String
  prevHash           String
  hash               String
  reversalOfId       String?
  reversalOf         LedgerEntry?        @relation("LedgerEntryReversal", fields: [reversalOfId], references: [id])
  reversals          LedgerEntry[]       @relation("LedgerEntryReversal")
  createdAt          DateTime            @default(now())

  @@index([walletId, createdAt])
  @@index([batchId])
  @@index([distributionItemId])
  @@index([type, referenceType, createdAt])
}

/// Lote de coins comprado por uma organização. Consumido em ordem FIFO
/// (por `expiresAt`) nas distribuições e na expiração diária.
/// pspChargeId nulo = lote do fluxo de aprovação manual (ASAAS_ENABLED=false, o padrão
/// atual) — nunca chamou o PSP. approvedByPlatformAdminId/rejectedByPlatformAdminId/
/// rejectionReason só existem no fluxo manual; lotes pagos via webhook do Asaas nunca os
/// preenchem (ausência = "pago pelo fluxo antigo", não dado faltando). Sem carimbo de tempo
/// dedicado pra aprovação/rejeição — `updatedAt` já serve (o status só muda uma vez).
model CoinBatch {
  id                         String       @id @default(cuid())
  organizationId             String
  organization               Organization @relation(fields: [organizationId], references: [id])
  totalCoins                 Int
  remainingCoins             Int
  priceInCents               Int
  status                     BatchStatus  @default(PENDING)
  expiresAt                  DateTime
  pspChargeId                String?      @unique
  idempotencyKey             String?      @unique
  approvedByPlatformAdminId  String?
  rejectedByPlatformAdminId  String?
  rejectionReason            String?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  ledgerEntries LedgerEntry[]

  @@index([organizationId, expiresAt])
}

/// Taxa global de conversão R$→coins (quantos coins uma organização recebe por real
/// aportado na compra de lote). Append-only, igual LedgerEntry: nunca UPDATE — mudar a
/// taxa insere uma linha nova, a mais recente por createdAt (da mesma organizationId) é a
/// vigente. Isso garante histórico de graça e garante estruturalmente que lotes já criados
/// nunca são reprecificados (nada além de BatchesService.createPendingBatch lê esta tabela
/// pra calcular preço). organizationId nullable: linhas antigas (taxa global, anterior ao
/// modelo por-empresa) ficam órfãs, história preservada — nenhum código novo as consulta.
model ConversionRate {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  /// Coins concedidos por R$ 1,00, × 100 (2 casas decimais, sem float — mesmo padrão de
  /// Partner.takeRateBps). Ex: 125 = 1,25 coins/real.
  coinsPerRealScaled Int
  createdAt          DateTime @default(now())

  @@index([organizationId, createdAt])
}

/// Uma operação de distribuição de coins — individual (csvFileUrl nulo)
/// ou em massa via CSV — disparada por um AdminUser.
model Distribution {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  adminUserId    String
  adminUser      AdminUser          @relation(fields: [adminUserId], references: [id])
  csvFileUrl     String?
  reason         String?
  totalItems     Int                @default(0)
  successItems   Int                @default(0)
  failedItems    Int                @default(0)
  status         DistributionStatus @default(PENDING)
  idempotencyKey String?            @unique
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  items DistributionItem[]

  @@index([organizationId])
}

/// Uma linha de uma Distribution (um CPF + valor). `membershipId` só é
/// preenchido quando o CPF é resolvido com sucesso. Linhas de upload em massa (CSV)
/// carregam o CPF em `cpfHash`/`cpfEncrypted` (nunca em claro, mesmo par de
/// cpf-crypto.util.ts que User usa) enquanto aguardam o job processar — assim que a
/// linha vira OK, os dois são zerados (minimização: User já é a fonte canônica a
/// partir daí). Linha FAILED mantém o CPF: é o único registro de qual CPF era essa
/// linha, necessário pro admin identificar o que corrigir.
model DistributionItem {
  id             String                 @id @default(cuid())
  distributionId String
  distribution   Distribution           @relation(fields: [distributionId], references: [id])
  membershipId   String?
  membership     Membership?            @relation(fields: [membershipId], references: [id])
  amount         Int
  status         DistributionItemStatus @default(PENDING)
  errorReason    String?
  cpfHash        String?
  cpfEncrypted   String?
  name           String?
  membershipType MembershipType?
  externalRef    String?
  createdAt      DateTime               @default(now())

  ledgerEntries LedgerEntry[]

  @@index([distributionId])
}

/// Motor de regras de recompensa automática de uma organização
/// (gatilho → recompensa → público → orçamento → período).
model Campaign {
  id                 String         @id @default(cuid())
  organizationId     String
  organization       Organization   @relation(fields: [organizationId], references: [id])
  name               String
  rules              Json
  budgetTotalInCoins Int
  budgetSpentInCoins Int            @default(0)
  status             CampaignStatus @default(DRAFT)
  startsAt           DateTime
  endsAt             DateTime
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([organizationId])
}

/// Parceiro da rede de resgate — compartilhado por todas as organizações
/// da plataforma (não pertence a uma Organization específica).
model Partner {
  id           String        @id @default(cuid())
  name         String
  cnpj         String        @unique
  category     String
  takeRateBps  Int
  pixKey       String
  contactEmail String?
  contactPhone String?
  latitude     Float?
  longitude    Float?
  /// Login do portal do parceiro (coins-partner). Nulo = parceiro ainda sem acesso
  /// provisionado — login por e-mail (contactEmail) falha nesse caso, não só por senha errada.
  passwordHash String?
  status       PartnerStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  offers        Offer[]
  redemptions   Redemption[]
  settlements   Settlement[]
  refreshTokens PartnerRefreshToken[]
}

/// Refresh token de sessão do parceiro (coins-partner) — mesmo mecanismo do UserRefreshToken
/// (rotação por family, hash sha256 em repouso, detecção de reuso), implementação paralela
/// pelo mesmo motivo: Partner não tem organizationId nem gera AuditLog.
model PartnerRefreshToken {
  id           String    @id @default(cuid())
  partnerId    String
  partner      Partner   @relation(fields: [partnerId], references: [id])
  tokenHash    String    @unique
  family       String
  replacedById String?   @unique
  revokedAt    DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  ip           String?
  userAgent    String?

  @@index([partnerId])
  @@index([family])
}

/// Oferta de resgate de um Partner, exibida no catálogo do coins-app.
/// validFrom/validUntil nulos = sem restrição de janela. perUserLimit nulo = sem limite por
/// pessoa (aplicado em RedemptionsService, na criação e na confirmação — ver Sessão 17).
/// imageUrl nulo = catálogo mostra placeholder no app, não é obrigatório no cadastro.
model Offer {
  id           String      @id @default(cuid())
  partnerId    String
  partner      Partner     @relation(fields: [partnerId], references: [id])
  title        String
  description  String
  category     String
  costInCoins  Int         @default(0)
  imageUrl     String?
  validFrom    DateTime?
  validUntil   DateTime?
  perUserLimit Int?
  status       OfferStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  redemptions Redemption[]

  @@index([partnerId])
}

/// Resgate de coins num parceiro. Criar um Redemption NÃO move coins —
/// o débito só acontece na confirmação (`ledgerEntryId` setado nesse momento).
/// idempotencyKey: mesmo padrão de CoinBatch/Distribution — POST /redemptions com a mesma
/// chave e os mesmos parâmetros devolve o resgate já criado, nunca duplica.
/// Resgate é compra instantânea (ver RedemptionsService.create()) — nasce já CONFIRMED, com
/// o débito já feito no ledger. deliveredAt/deliveredByType/deliveredById registram só a
/// entrega física (marcada pelo Partner dono ou por um PlatformAdmin), sem efeito
/// financeiro nenhum — nunca mexem em coins.
model Redemption {
  id              String           @id @default(cuid())
  membershipId    String
  membership      Membership       @relation(fields: [membershipId], references: [id])
  walletId        String
  wallet          Wallet           @relation(fields: [walletId], references: [id])
  partnerId       String
  partner         Partner          @relation(fields: [partnerId], references: [id])
  offerId         String?
  offer           Offer?           @relation(fields: [offerId], references: [id])
  amount          Int
  pickupCode      String           @unique
  qrPayload       String           @unique
  idempotencyKey  String           @unique
  status          RedemptionStatus
  confirmedAt     DateTime?
  ledgerEntryId   String?
  deliveredAt     DateTime?
  deliveredByType DeliveredByType?
  deliveredById   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([partnerId, status])
}

/// Transferência de coins entre dois membros da MESMA organização (produto validado
/// juridicamente — ver CLAUDE.md "O que NÃO fazer"). Tabela própria (mesmo padrão de
/// CoinBatch/Distribution/Redemption) em vez de inferir do LedgerEntry — sustenta a
/// checagem do limite diário (@@index([fromMembershipId, createdAt])) sem varrer a maior
/// tabela do banco. debitLedgerEntryId/creditLedgerEntryId apontam pras duas entries
/// criadas atomicamente por LedgerService.transferBetweenWallets().
model Transfer {
  id                  String     @id @default(cuid())
  fromMembershipId    String
  fromMembership      Membership @relation("TransferSender", fields: [fromMembershipId], references: [id])
  toMembershipId      String
  toMembership        Membership @relation("TransferRecipient", fields: [toMembershipId], references: [id])
  amount              Int
  idempotencyKey      String     @unique
  debitLedgerEntryId  String?
  creditLedgerEntryId String?
  createdAt           DateTime   @default(now())

  @@index([fromMembershipId, createdAt])
}

/// Fechamento periódico (semanal) dos resgates confirmados de um parceiro,
/// com o repasse líquido calculado a partir do takeRate.
model Settlement {
  id            String           @id @default(cuid())
  partnerId     String
  partner       Partner          @relation(fields: [partnerId], references: [id])
  periodStart   DateTime
  periodEnd     DateTime
  grossInCents  Int
  takeRateBps   Int
  netInCents    Int
  status        SettlementStatus @default(OPEN)
  pixReceiptUrl String?
  paidAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([partnerId, periodStart, periodEnd])
}

/// Registro de toda escrita relevante de uma Organization — feita por um AdminUser
/// (`actorType: ADMIN`, `actorAdminUserId` presente) ou por um processo automático
/// (webhook do PSP, job agendado — `actorType: SYSTEM`, `actorAdminUserId` nulo).
model AuditLog {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])
  actorType        AuditActorType @default(ADMIN)
  actorAdminUserId String?
  actorAdminUser   AdminUser?     @relation(fields: [actorAdminUserId], references: [id])
  action           String
  payload          Json
  ip               String
  createdAt        DateTime       @default(now())

  @@index([organizationId, createdAt])
}

/// Convite pendente de um AdminUser. Só vira AdminUser de fato no aceite (define senha) —
/// evita ter que tornar passwordHash nullable pra representar o estado "convidado".
/// invitedByAdminUserId nulo = convite "de sistema", criado fora do HTTP (script de
/// bootstrap do primeiro OWNER de uma organização nova — não existe admin nenhum ainda
/// pra convidar). O endpoint POST /organizations/admins/invites sempre preenche esse
/// campo; só o script de bootstrap cria um convite com ele nulo.
model AdminInvite {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])
  email                String
  role                 AdminRole
  tokenHash            String       @unique
  invitedByAdminUserId String?
  invitedByAdminUser   AdminUser?   @relation(fields: [invitedByAdminUserId], references: [id])
  expiresAt            DateTime
  acceptedAt           DateTime?
  revokedAt            DateTime?
  createdAt            DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
}

/// Histórico de execuções dos jobs agendados (auditoria/painel admin).
/// Escrito exclusivamente pelos próprios jobs — nunca pela API pública.
model JobRun {
  id          String       @id @default(cuid())
  jobName     JobName
  status      JobRunStatus @default(RUNNING)
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  issuesFound Int          @default(0)
  details     Json?

  @@index([jobName, startedAt])
  @@index([status])
}

/// Refresh token de AdminUser — nunca armazenado em claro, só o hash (sha256).
/// `family` agrupa uma cadeia de rotação: nasce nova a cada login, persiste entre
/// rotações. Reuso de um token já revogado (`revokedAt` setado) indica token roubado —
/// derruba a family inteira.
model RefreshToken {
  id           String    @id @default(cuid())
  adminUserId  String
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id])
  tokenHash    String    @unique
  family       String
  replacedById String?   @unique
  revokedAt    DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  ip           String?
  userAgent    String?

  @@index([adminUserId])
  @@index([family])
}
